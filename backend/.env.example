# Copiar a backend/.env (no se sube a Git) y llenar los valores.
DB_USERNAME=postgres
DB_PASSWORD=
# Base64 de al menos 32 bytes. Generar con: openssl rand -base64 32
JWT_SECRET=
# Contraseña de las cuentas demo que crea el perfil dev.
DEMO_PASSWORD=
# Opcional. Por defecto: jdbc:postgresql://localhost:5432/tutorias_db
# DB_URL=jdbc:postgresql://localhost:5432/tutorias_db
